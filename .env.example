# Environment
ENVIRONMENT=local
DEBUG=true

# Port mappings
POSTGRES_PORT=5434
REDIS_PORT=6380
BACKEND_PORT=8001

# PostgreSQL
POSTGRES_DB=ccdip
POSTGRES_USER=ccdip
POSTGRES_PASSWORD=ccdip-local
DATABASE_URL=postgresql+asyncpg://ccdip:ccdip-local@localhost:5434/ccdip
TEST_DATABASE_URL=postgresql+asyncpg://ccdip:ccdip-local@localhost:5434/ccdip_test

# Redis
REDIS_URL=redis://localhost:6380/0

# Neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ccdip-local
NEO4J_URI=bolt://localhost:7687

# MinIO Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=ccdip-local
STORAGE_BUCKET=ccdip-documents

# Frontend API Target
VITE_API_BASE_URL=http://localhost:8001
